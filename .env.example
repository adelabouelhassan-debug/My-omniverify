# Database Configuration
# Get this from Supabase: Settings > Database > Connection string (URI)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Server Port
PORT=8787

# Optional: Add these when you're ready for production
# SMS Provider (Twilio, Vonage, MessageBird, etc.)
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM=your_twilio_phone_number

# WhatsApp (Meta WhatsApp Cloud API)
# WHATSAPP_PROVIDER_TOKEN=your_whatsapp_token
# WHATSAPP_PHONE_ID=your_phone_id

# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
